{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "worker/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts",
    "lib/format.ts"
  ],
  "exclude": [
    "test/reachability.test.ts"
  ]
}
