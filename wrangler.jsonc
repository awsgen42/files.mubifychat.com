{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mubifiles",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The exported Next.js UI. Every request runs the Worker first; it issues
  // the trailing-slash redirect, handles /api/*, and hands everything else to
  // the static assets.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Every request, not just /api/*, so worker/index.ts can issue the
    // trailing-slash 308 before anything else answers.
    //
    // It was ["/api/*"], which meant the asset server answered every page
    // request first and the Worker's non-API branch never ran at all. That
    // branch looked like it was serving the UI; measured against `wrangler
    // dev`, it was unreachable.
    //
    // The redirect has to come from the Worker because the asset server's own
    // handling cannot do it: "auto-trailing-slash" and "force-trailing-slash"
    // were both measured, and both redirect the bare form to the slashed one
    // with a 307. A temporary redirect leaves the bare URL as a candidate,
    // which is the whole defect. html_handling is therefore left at its
    // default — the Worker gets there first.
    //
    // The cost is a Worker invocation on every request rather than only on
    // /api/*. Measured alongside it: assets, the manifest, the sitemap and the
    // RSC payloads all still serve with the right content types, /api/* is not
    // redirected, and ?code= survives the redirect.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },

  // Guards the polled session-state endpoint. Cloudflare's native limiter is
  // used here rather than the KV counter in worker/ratelimit.ts because this
  // route runs every few seconds per device: a KV write per request would cost
  // far more than the traffic it is protecting. Counted per colo, not globally.
  // Tune `limit` alongside POLL_ACTIVE_MS in lib/tuning.ts.
  "ratelimits": [
    {
      "name": "POLL_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    // Guards each part of a multipart upload. Separate from the KV `sendItem`
    // bucket on purpose: that one stops item spam, while a part is one slow
    // throughput-bound request, and the KV counter's write-per-request would
    // cost ~20 writes per large file against a 1,000/day budget. 120/min is
    // unreachable in practice — at 25 MB a part it needs ~400 Mbps upstream.
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],

  // Session metadata: code -> session document, with a sliding TTL.
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "a66bae96025841bb8c53e280703745ba",
      "preview_id": "725f28d2cf72493cb533ffb1079efb9c"
    }
  ],

  // File bodies. Zero egress cost, which is what makes this app cheap to run.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mubifiles",
      "preview_bucket_name": "mubifiles-preview"
    }
  ],

  // Purges R2 objects whose session has already expired out of KV.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "vars": {
    // Sliding inactivity window, seconds. Reset on every send/fetch.
    "SESSION_IDLE_TTL_SECONDS": "900",
    // Hard cap regardless of activity, seconds.
    "SESSION_MAX_TTL_SECONDS": "86400",
    // Keep in step with MAX_FILE_BYTES / MAX_SESSION_BYTES in shared/limits.ts,
    // which is what every user-facing statement of the limits is generated
    // from. test/limits.test.ts fails if these drift apart.
    "MAX_FILE_BYTES": "1073741824",
    "MAX_SESSION_BYTES": "3221225472",
    "MAX_ITEMS": "50",
    "MAX_TEXT_CHARS": "100000",
    // Origins allowed to call the API cross-origin, comma-separated. Only
    // needed when the UI is hosted separately (e.g. on Vercel); the Worker's
    // own origin never needs listing. Matched exactly, so www and the apex
    // are distinct entries, and Vercel preview URLs need adding by hand.
    "ALLOWED_ORIGINS": "https://www.mubifiles.com,https://mubifiles.com"
    // Optional, set as secrets to enable direct browser -> R2 presigned uploads:
    //   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
    // Without them the Worker proxies uploads instead.
  }
}
