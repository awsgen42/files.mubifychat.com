{
  "name": "mubifiles",
  "version": "0.1.0",
  "private": true,
  "description": "Instant text & file sharing between devices, built on Cloudflare R2.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/strip-worker-source.mjs && node scripts/gen-sw.mjs && node scripts/verify-output.mjs && vitest run",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.60",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "aws4fetch": "^1.0.20",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
